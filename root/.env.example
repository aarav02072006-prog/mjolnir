# Environment Variables — Meesho Platform
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to Git.

# -------------------------------------------------------
# DATABASE
# -------------------------------------------------------
# SQLite (development — works out of the box, no install required)
DATABASE_URL="file:./prisma/dev.db"

# PostgreSQL (production — uncomment and fill in if deploying)
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/meesho_db?schema=public"

# -------------------------------------------------------
# AUTHENTICATION
# -------------------------------------------------------
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Must be at least 32 characters. Keep this secret.
NEXTAUTH_SECRET="replace-with-a-64-byte-hex-secret-min-32-chars"

# The URL this app runs at (no trailing slash)
NEXTAUTH_URL="http://localhost:3000"

# -------------------------------------------------------
# ORGANIZER DATASET PATH
# -------------------------------------------------------
# Absolute path to meesho_generated.csv on your machine.
# Leave blank if you keep the dataset at the default relative location:
#   <workspace-root>/dataset/meesho_dataset-main/meesho_generated.csv
#
# Example (Windows):
#   MEESHO_DATASET_PATH="C:\Users\yourname\Desktop\tt\dataset\meesho_dataset-main\meesho_generated.csv"
# Example (macOS / Linux):
#   MEESHO_DATASET_PATH="/home/yourname/meesho/dataset/meesho_generated.csv"
MEESHO_DATASET_PATH=""

# -------------------------------------------------------
# CRON JOB (expired reservation cleanup)
# -------------------------------------------------------
# Any random string — used to authenticate GET /api/cron/cleanup-locks
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET="replace-with-a-random-cron-secret"

# Razorpay Test Mode Credentials
RAZORPAY_KEY_ID="rzp_test_TlrIpbBRWuTOBy"
RAZORPAY_KEY_SECRET="piOmrCSqXhX4oVwDlbCMIvcV"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret"

